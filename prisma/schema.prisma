generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/prisma"
}

datasource db {
  provider = "postgresql"
}

model Campione {
  ID                     String               @id
  nome                   String               @unique
  Icona                  String               @unique
  Titolo                 String               @unique
  Descrizione            String
  Ruolo                  String
  SetStatistiche         Int                  @default(0)
  Role                   Ruolo                @relation(fields: [Ruolo], references: [Nome])
  Stats                  SetBase              @relation(fields: [SetStatistiche], references: [IdStatistiche])
  Posizione              Campione_Posizione[]
  Razza                  Campione_Razza[]
  Regione                Campione_Regione[]
  Config                 Configurazione[]
  Cosmetico              Cosmetico[]
  Kit                    Kit[]
}

model Cosmetico {
  IdCampione    String
  Immagine      String
  NomeCosmetico String
  champ         Campione @relation(fields: [IdCampione], references: [ID])

  @@id([IdCampione, NomeCosmetico])
}

model Ruolo {
  Nome        String     @id
  Descrizione String
  Campione    Campione[]
}

model Razza {
  Nome        String           @id
  Descrizione String
  relazione   Campione_Razza[]
}

model Campione_Razza {
  IdCampione String
  NomeRazza  String
  champ      Campione @relation(fields: [IdCampione], references: [ID])
  razza      Razza    @relation(fields: [NomeRazza], references: [Nome])

  @@id([IdCampione, NomeRazza])
}

model Posizione {
  Nome String               @id
  pos  Campione_Posizione[]
}

model Campione_Posizione {
  IdCampione    String
  NomePosizione String
  champ         Campione  @relation(fields: [IdCampione], references: [ID])
  Pos           Posizione @relation(fields: [NomePosizione], references: [Nome])

  @@id([IdCampione, NomePosizione])
}

model Regione {
  Nome        String             @id
  Descrizione String
  Regi        Campione_Regione[]
}

model Campione_Regione {
  IdCampione  String
  NomeRegione String
  champ       Campione @relation(fields: [IdCampione], references: [ID])
  Regi        Regione  @relation(fields: [NomeRegione], references: [Nome])

  @@id([IdCampione, NomeRegione])
}

model Incantesimo {
  Nome        String           @id
  Descrizione String
  Ricarica    Float
  Incant1     Configurazione[] @relation("Inc1")
  Incant2     Configurazione[] @relation("Inc2")
}

model Configurazione {
  IdCampione   String
  Incantesimo1 String
  Incantesimo2 String
  Runa         Int
  IdAccount    Int
  TitoloConf   String       @default("New Build")
  User         Account      @relation(fields: [IdAccount], references: [AccountId])
  champ        Campione     @relation(fields: [IdCampione], references: [ID])
  Inc1         Incantesimo  @relation("Inc1", fields: [Incantesimo1], references: [Nome])
  Inc2         Incantesimo  @relation("Inc2", fields: [Incantesimo2], references: [Nome])
  Pag_Runa     Pagina_Runa @relation(fields: [Runa], references: [Id])
  Inv          Inventario[]
  Partite      Partita[]

  @@id([TitoloConf, IdAccount])
}

model Oggetto {
  Nome           String       @id
  Costo          Int
  Descrizione    String
  Immagine       String
  SetStatistiche Int          @default(0)
  Stats        SetBase @relation(fields: [SetStatistiche], references: [IdStatistiche])
  Inv            Inventario[]
}

model Inventario {
  NomeOggetto      String
  IdAccount        Int
  IdConfigurazione String
  Configurazione   Configurazione @relation(fields: [IdConfigurazione, IdAccount], references: [TitoloConf, IdAccount])
  Oggetto          Oggetto        @relation(fields: [NomeOggetto], references: [Nome])

  @@id([IdConfigurazione, NomeOggetto])
}

model Account {
  Nome         String           @unique
  AccountId    Int              @id @default(autoincrement())
  Password     String
  Descrizione  String           @default("Hi! I'm new here.")
  Immagine     String           @default("https://y2gjsxxeqdmvlbby.public.blob.vercel-storage.com/items/Poro-Snax_item_HD.png")
  RiotID       String?          @unique @db.VarChar(50)
  IsAdmin      Boolean          @default(false)
  Config       Configurazione[]
  Partita      Partita[]
  ReportRicev  Report[]         @relation("Author")
  ReportCreati Report[]         @relation("Target")
  sessione     Sessione?
  Banned       Banned_Account?
}

model Sessione {
  Id           Int      @id @default(autoincrement())
  guid_id      String   @unique
  user_id      Int      @unique
  date_created DateTime @default(now())
  date_expired DateTime
  user         Account  @relation(fields: [user_id], references: [AccountId], onDelete: Cascade)
}

model Report {
  IdTarget    Int
  IdAutore    Int
  Motivazione String
  Data_Creazione  DateTime
  Descrizione String?
  Author      Account         @relation("Author", fields: [IdAutore], references: [AccountId])
  Target      Account         @relation("Target", fields: [IdTarget], references: [AccountId])

  @@id([IdTarget, IdAutore])
}

model Banned_Account {
  AccountId       Int     @id
  Expiration_Date      DateTime
  Motivazione     String
  Descrizione     String?
  Account         Account @relation(fields: [AccountId], references: [AccountId])
}

model Kit {
  IdKit      Int           @id @default(autoincrement())
  IdCampione String
  champ      Campione      @relation(fields: [IdCampione], references: [ID])
  abilita    Kit_Abilita[]

  @@index([IdCampione])
}

model Abilita {
  Id           Int          @id @default(autoincrement())
  NomeAbilità String       @unique
  Descrizione  String
  Immagine     String
  KitAb        Kit_Abilita?
}

model Kit_Abilita {
  IdKit     Int
  IdAbilita Int          @unique
  Tipo      Tipo_Abilita
  abilita   Abilita      @relation(fields: [IdAbilita], references: [Id])
  kit       Kit          @relation(fields: [IdKit], references: [IdKit])

  @@id([IdKit, Tipo])
}

model Pagina_Runa {
  Id             Int              @id @default(autoincrement())
  RunaPrimaria   Int
  RunaSecondaria Int
  Frammenti      Int
  Conf           Configurazione[]
  Shards         Sezione_Runa     @relation("Shards", fields: [Frammenti], references: [Id])
  Principale     Sezione_Runa     @relation("Primaria", fields: [RunaPrimaria], references: [Id])
  Secondaria     Sezione_Runa     @relation("Secondaria", fields: [RunaSecondaria], references: [Id])
}

model Sezione_Runa {
  Id            Int           @id @default(autoincrement())
  Pietrachiave  String
  RigaSuperiore String
  RigaCentrale  String
  RigaInferiore String
  Shard         Pagina_Runa[] @relation("Shards")
  Prim          Pagina_Runa[] @relation("Primaria")
  Secon         Pagina_Runa[] @relation("Secondaria")
  Keystone      Runa          @relation("Keystone", fields: [Pietrachiave], references: [Nome])
  Middle        Runa          @relation("Centrale", fields: [RigaCentrale], references: [Nome])
  Lower         Runa          @relation("Ultima", fields: [RigaInferiore], references: [Nome])
  First         Runa          @relation("Prima", fields: [RigaSuperiore], references: [Nome])
}

model Runa {
  Nome        String         @id
  Descrizione String
  CamminoId   Int
  Grado       Int
  Deprecata   Boolean        @default(false)
  Immagine    String
  Camm        Tipologia_runa @relation(fields: [CamminoId], references: [Id])
  keystone    Sezione_Runa[] @relation("Keystone")
  Centrale    Sezione_Runa[] @relation("Centrale")
  Ultima      Sezione_Runa[] @relation("Ultima")
  Prima       Sezione_Runa[] @relation("Prima")
}

model Tipologia_runa {
  Id   Int    @id
  Nome String
  Camm Runa[]
}

model Partita {
  ConfigurazioneId String
  Data             DateTime       @default(now())
  Risultato        Risultato
  AccountId        Int
  Assist           Int            @default(0)
  Morti            Int            @default(0)
  Uccisioni        Int            @default(0)
  Account          Account        @relation(fields: [AccountId], references: [AccountId], onDelete: Cascade)
  Configurazione   Configurazione @relation(fields: [ConfigurazioneId, AccountId], references: [TitoloConf, IdAccount], onDelete: Cascade)

  @@id([AccountId, Data])
}

model Modifica {
  Soggetto_modifica String
  Id_Statistica     Int
  Versione          String
  Nuovo_Valore      Float
  Stat              Statistica @relation(fields: [Id_Statistica], references: [Id])
  Vers              Storico    @relation(fields: [Versione], references: [Versione])

  @@id([Soggetto_modifica, Id_Statistica, Versione])
}

model Storico {
  Versione String     @id
  Data     DateTime
  Modif    Modifica[]
}

model Statistica {
  Id   Int        @id
  Nome String
  Stat Modifica[]
}

model SetBase {
  IdStatistiche                Int   @id
  Vita                         Int
  VitaPerLivello               Int
  Mana                         Int
  ManaPerLivello               Int
  Velocità_di_movimento        Int
  Armatura                     Float
  ArmaturaPerLivello           Float
  ResistenzaMagica             Float
  ResistenzaMagicaPerLivello   Float
  Gittata                      Int
  RigenerazioneVita            Float
  RigenerazioneMana            Float
  RigenerazioneManaPerLivello  Float
  Critico                      Float
  CriticoPerLivello            Float
  Attacco                      Float
  AttaccoPerLivello            Float
  VelocitàDiAttacco           Float
  VelocitàDiAttaccoPerLivello Float
  AttaccoMagico                Int   @default(0)
  Champ Campione[]
  Item Oggetto[]
}

enum Tipo_Abilita {
  Passiva
  Abilità1
  Abilità2
  Abilità3
  Abilità4
}

enum Risultato {
  Vittoria
  Sconfitta
  Remake
}
