// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/lib/server/prisma"
}

datasource db {
  provider = "postgresql"
}

// Esempio di modello
model Campione {
  ID   String     @id 
  nome String  @unique
  Icona  String @unique
  Titolo String @unique
  Descrizione String 
  Ruolo String
  Vita  Int
  Mana  Int
  Attacco Decimal
  AttaccoMagico Int @default(0)
  Velocità_di_movimento Int
  Armatura  Decimal
  Resistenza_magica Decimal
  Velocità_di_attacco Decimal
  Gittata Int
  Kit Kit[]
  Cosmetico Cosmetico[]
  Regione Campione_Regione[]
  Razza Campione_Razza[]
  Posizione Campione_Posizione[]
  Config Configurazione[]
  Role Ruolo @relation(fields: [Ruolo], references: [Nome]) 
}

model Cosmetico{
  NomeCosmetico String @unique
  IdCampione String
  Immagine String //? not sure
 // Modello 
  champ Campione  @relation(fields: [IdCampione], references: [ID])
  @@id([IdCampione, NomeCosmetico])
}

model Ruolo{
  Nome String @id
  Descrizione String 
  Campione Campione[]
  }

model Razza{
  Nome String @id
  Descrizione String 
  relazione Campione_Razza[]
}

model Campione_Razza{
  IdCampione String
  NomeRazza String
  champ Campione @relation(fields: [IdCampione], references: [ID])
  razza Razza @relation(fields: [NomeRazza], references: [Nome])
  @@id([IdCampione, NomeRazza])
}

model Posizione{
  Nome String @id 
  pos Campione_Posizione[]
}


model Campione_Posizione {
  IdCampione String
  NomePosizione String
  champ Campione @relation(fields:[IdCampione], references: [ID])
  Pos Posizione @relation(fields: [NomePosizione], references: [Nome]) 
  @@id([IdCampione, NomePosizione])

}

model Regione{
  Nome String @id 
  Descrizione String
  Regi Campione_Regione[]
  }

model Campione_Regione {
  IdCampione String
  NomeRegione String
  champ Campione @relation(fields: [IdCampione], references: [ID])
  Regi Regione @relation(fields: [NomeRegione], references: [Nome]) 
  @@id([IdCampione, NomeRegione])

}

model Incantesimo{
  Nome String @id
  Descrizione String 
  Ricarica Decimal
  Incant1 Configurazione[] @relation("Inc1")
  Incant2 Configurazione[] @relation("Inc2")
}

model Configurazione{
  ID Int @id @default(autoincrement())
  IdCampione String
  Incantesimo1 String
  Incantesimo2 String
  Account Int
  Runa Int
  champ Campione @relation(fields: [IdCampione], references: [ID])
  Inc1 Incantesimo @relation(fields: [Incantesimo1], references: [Nome], name: "Inc1")
  Inc2 Incantesimo @relation(fields: [Incantesimo2], references: [Nome], name: "Inc2") 
  User Account @relation(fields: [Account], references: [AccountId]) 
  Pag_Runa Pagina_Runa @relation(fields: [Runa], references: [Id])
  Partite Partita[]
  Inv Inventario[]
}

model Oggetto{
  Nome String @id
  Costo Int
  Descrizione String 
  Immagine String
  Inv Inventario[]
}

model Inventario{
  IdInventario Int 
  NomeOggetto String
  Configurazione Configurazione @relation(fields: [IdInventario],references: [ID])
  Oggetto Oggetto @relation(fields: [NomeOggetto],references: [Nome])
  @@id([IdInventario,NomeOggetto])

}

model Account{
  Nome String @unique
  AccountId Int @id @default(autoincrement())
  Password String 
  Descrizione String 
  Immagine String //?
  RiotID String? @db.VarChar(50) @unique
  IsAdmin Boolean
  sessione Sessione[]
  Config Configurazione[]
  Partita Partita[] 
}

model Sessione{
  Id Int @id 
  guid_id String @unique
  user_id Int 
  date_created DateTime @default(now())
  date_expired DateTime
  user Account @relation(fields: [user_id], references: [AccountId], onDelete: Cascade)  
}

model Kit {
  IdKit Int @id @default(autoincrement())
  IdCampione String
  champ Campione    @relation(fields: [IdCampione], references: [ID])
  abilita Kit_Abilita[]
  @@index([IdCampione])
}

enum Tipo_Abilita{
  Passiva
  Abilità1
  Abilità2
  Abilità3
  Abilità4
}

model Abilita{
  Id  Int @id @default(autoincrement())
  NomeAbilità String @unique
  Descrizione String
  KitAb Kit_Abilita[]
}

model Kit_Abilita {
  IdKit Int
  IdAbilita Int @unique
  Tipo Tipo_Abilita

  kit Kit @relation(fields: [IdKit], references: [IdKit])
  abilita Abilita @relation(fields: [IdAbilita], references: [Id])

  @@id([IdKit, Tipo])
}

model Pagina_Runa{
  Id Int @id
  RunaPrimaria Int
  RunaSecondaria Int
  Frammenti Int
  Principale Sezione_Runa @relation(fields: [RunaPrimaria], references: [Id], name: "Primaria")
  Secondaria Sezione_Runa @relation(fields: [RunaSecondaria], references: [Id], name: "Secondaria")
  Shards Sezione_Runa @relation(fields: [Frammenti], references: [Id], name: "Shards")
  Conf Configurazione[]
}

model Sezione_Runa{
  Id Int @id
  Pietrachiave String
  RigaSuperiore String
  RigaCentrale  String
  RigaInferiore String
  Prim Pagina_Runa[]  @relation("Primaria")
  Secon Pagina_Runa[] @relation("Secondaria")
  Shard Pagina_Runa[] @relation("Shards")
  Keystone Runa @relation(fields: [Pietrachiave], references: [Nome], name: "Keystone")
  First Runa @relation(fields: [RigaSuperiore], references: [Nome], name: "Prima")
  Middle Runa @relation(fields: [RigaCentrale], references: [Nome], name: "Centrale")
  Lower Runa @relation(fields: [RigaInferiore], references: [Nome], name: "Ultima")
}


model Runa {
  Nome String  @id
  Descrizione String
  CamminoId Int
  Grado Int
  Immagine String
  Deprecata Boolean @default(false)
  Camm Tipologia_runa @relation(fields: [CamminoId], references: [Id])
  keystone Sezione_Runa[] @relation("Keystone")
  Prima Sezione_Runa[] @relation("Prima")
  Centrale Sezione_Runa[] @relation("Centrale")
  Ultima Sezione_Runa[] @relation("Ultima")
}

model Tipologia_runa{
  Id Int @id 
  Nome String
  Camm Runa[] 
}

model Partita{
  Id Int @id @default(autoincrement())
  ConfigurazioneId Int
  Data DateTime @default(now())
  Risultato Risultato
  AccountId Int
  Acc Account @relation(fields: [AccountId], references: [AccountId])
  Configurazione Configurazione @relation(fields: [ConfigurazioneId], references: [ID])
}

enum Risultato{
  Vittoria  
  Sconfitta
  Remake 
}

model Modifica{
  Soggetto_modifica String 
  Id_Statistica Int
  Nuovo_Valore Decimal 
  Versione String
  Vers Storico @relation(fields: [Versione], references: [Versione])
  Stat Statistica @relation(fields: [Id_Statistica], references: [Id])
  @@id([Soggetto_modifica,Id_Statistica,Versione])
}

model Storico{
  Versione String @id
  Data DateTime
  Modif Modifica[]
}


model Statistica{
  Id Int @id
  Nome String 
  Livello Int 
  Stat Modifica[]
}
